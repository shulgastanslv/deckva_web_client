// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum OrgMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum BillingPaymentKind {
  SUBSCRIPTION
  CREDITS
  CARD_VERIFY
  REFUND
}

enum CreditBucket {
  PLAN
  TOPUP
}

enum CreditLedgerKind {
  GRANT
  SPEND
  REFUND
  ADJUSTMENT
}

enum OrganizationInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  /// Null for OAuth-only accounts (e.g. Google).
  password  String?
  name      String?
  image     String?
  role      UserRole @default(USER)
  /// Set when the user confirms the inbox, or for accounts that existed before verification.
  emailVerified DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Personal Pro subscription (15 BYN / month).
  subscriptionStatus   SubscriptionStatus @default(NONE)
  subscriptionEndsAt   DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  /// Provider customer id (bePaid / Stripe / …) — set by the active payment adapter.
  paymentCustomerId    String?

  /// Successful AI generations used on the free plan (Pro ignores this).
  freeGenerationsUsed Int @default(0)

  /// Pro monthly grant balance (refreshed on subscribe / renew).
  creditPlanBalance  Int @default(0)
  /// Purchased top-up credits (do not reset on renew).
  creditTopupBalance Int @default(0)

  activeOrganizationId String?
  activeOrganization   Organization? @relation("UserActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  projects        Project[]
  folders         Folder[]
  memberships     OrganizationMember[]
  sentInvites     OrganizationInvite[] @relation("OrganizationInviteSender")
  savedProjects   SavedProject[]
  authTokens      AuthToken[]
  news            News[]
  notifications   Notification[]
  feedbacks       Feedback[]
  paymentMethods  PaymentMethod[]
  billingPayments BillingPayment[]
  creditLedger    CreditLedgerEntry[]
  mediaAssets     MediaAsset[]
  communityEdits  Project[]            @relation("CommunityEditor")
  connectors      ConnectorAccount[]
  connectorEvents ConnectorEvent[]

  @@index([activeOrganizationId])
  @@index([subscriptionStatus])
}

model CreditLedgerEntry {
  id           String           @id @default(cuid())
  kind         CreditLedgerKind
  bucket       CreditBucket
  amount       Int
  balanceAfter Int
  modelId      String?
  coraRunId    String?
  projectId    String?
  meta         Json?
  createdAt    DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([coraRunId])
}

enum ConnectorProvider {
  GOOGLE_DRIVE
  THREADS
}

enum ConnectorStatus {
  DISCONNECTED
  CONNECTED
  ERROR
  EXPIRED
}

enum ConnectorEventKind {
  CONNECT
  DISCONNECT
  REFRESH
  SYNC
  IMPORT
  PUBLISH
  ERROR
  INSIGHTS
}

/// Third-party OAuth link (Drive files, Threads publish/insights) — separate from login.
model ConnectorAccount {
  id                String            @id @default(cuid())
  provider          ConnectorProvider
  status            ConnectorStatus   @default(DISCONNECTED)
  externalAccountId String?
  displayName       String?
  avatarUrl         String?
  scopes            String[]          @default([])
  /// AES-GCM payload (iv + ciphertext), never raw OAuth secrets.
  accessTokenEnc    String?           @db.Text
  refreshTokenEnc   String?           @db.Text
  tokenExpiresAt    DateTime?
  metadata          Json?
  lastSyncedAt      DateTime?
  connectedAt       DateTime?
  errorMessage      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  events ConnectorEvent[]

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider, status])
}

/// Product + connector activity for the Connectors analytics panel.
model ConnectorEvent {
  id        String             @id @default(cuid())
  provider  ConnectorProvider
  kind      ConnectorEventKind
  label     String?
  meta      Json?
  createdAt DateTime           @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  connectorId String?
  connector   ConnectorAccount? @relation(fields: [connectorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, provider, createdAt])
  @@index([connectorId, createdAt])
}

/// User image library for the editor Assets panel (logos, screenshots, fills).
model MediaAsset {
  id        String   @id @default(cuid())
  name      String
  dataUrl   String   @db.Text
  mimeType  String   @default("image/png")
  tags      String[] @default([])
  width     Int?
  height    Int?
  bytes     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, updatedAt])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#7EB6FF")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        OrganizationMember[]
  invites        OrganizationInvite[]
  folders        Folder[]
  projects       Project[]
  activeForUsers User[]               @relation("UserActiveOrganization")
}

/// Email or open-link invite to join an organization.
model OrganizationInvite {
  id        String                   @id @default(cuid())
  token     String                   @unique
  /// Null = reusable open invite link for the organization.
  email     String?
  role      OrgMemberRole            @default(MEMBER)
  status    OrganizationInviteStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime                 @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("OrganizationInviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([email, status])
  @@index([expiresAt])
}

/// Saved card for recurring Pro billing. PAN/CVV are never stored — only token + display fields.
model PaymentMethod {
  id               String   @id @default(cuid())
  brand            String
  last4            String
  expMonth         Int
  expYear          Int
  /// Opaque token from the active payment provider (never store PAN/CVV).
  providerToken    String
  providerCustomer String?
  isDefault        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  payments BillingPayment[]

  @@index([userId])
}

model BillingPayment {
  id          String               @id @default(cuid())
  amount      Int
  currency    String               @default("BYN")
  status      BillingPaymentStatus @default(PENDING)
  kind        BillingPaymentKind   @default(SUBSCRIPTION)
  description String?
  providerRef String?
  failureReason String?
  paidAt      DateTime?
  createdAt   DateTime             @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
}

model OrganizationMember {
  id        String        @id @default(cuid())
  role      OrgMemberRole @default(MEMBER)
  createdAt DateTime      @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

/// Folder for grouping carousel projects (scoped to an organization).
model Folder {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projects Project[]

  @@index([userId])
  @@index([userId, updatedAt])
  @@index([organizationId])
}

/// One-time links for email confirmation and password reset.
model AuthToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, type])
}

enum CommunityStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model Project {
  id          String   @id @default(cuid())
  title       String   @default("Untitled Carousel")
  aspectRatio String   @default("4:5")
  width       Int      @default(1080)
  height      Int      @default(1350)
  canvasJSON  Json
  thumbnail  String? @db.Text
  isPublic    Boolean  @default(false)
  /// First time the project was submitted to community.
  publishedAt DateTime?
  /// Last community republish / listing update.
  communityUpdatedAt DateTime?
  communityStatus CommunityStatus @default(DRAFT)
  /// Browse filter (Business, Lifestyle, …).
  communityCategory String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Soft-delete: set when moved to Trash; null while active.
  trashedAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Who last republished / updated the community listing.
  communityUpdatedById String?
  communityUpdatedBy   User?   @relation("CommunityEditor", fields: [communityUpdatedById], references: [id], onDelete: SetNull)

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  slides       Slide[]
  savedBy      SavedProject[]

  @@index([userId])
  @@index([userId, updatedAt])
  @@index([userId, trashedAt])
  @@index([folderId])
  @@index([organizationId])
  @@index([trashedAt])
  @@index([communityStatus, publishedAt])
  @@index([isPublic, communityStatus])
  @@index([communityCategory, communityStatus])
  @@index([communityUpdatedAt])
}


/// One Fabric canvas snapshot in a carousel project.
/// Client uses ephemeral numeric ids; persistence key is `id` + `order`.
model Slide {
  id         String  @id @default(cuid())
  order      Int
  canvasJSON Json
  thumbnail  String? @db.Text

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

/// A post from the admin desk. Publishing one also notifies every user.
model News {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  notifications Notification[]

  @@index([createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  title     String
  body      String    @db.Text
  /// Optional deep link (e.g. /invite/token) shown as a CTA in the inbox.
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  newsId String?
  news   News?   @relation(fields: [newsId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

/// User notes from the studio. Images are data URLs when attached.
model Feedback {
  id        String   @id @default(cuid())
  message   String   @db.Text
  images    String[] @default([])
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Bookmarks / "saved" projects for a user (not ownership).
model SavedProject {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}
