// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum OrgMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum BillingPaymentKind {
  SUBSCRIPTION
  CARD_VERIFY
  REFUND
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  /// Null for OAuth-only accounts (e.g. Google).
  password  String?
  name      String?
  image     String?
  role      UserRole @default(USER)
  /// Set when the user confirms the inbox, or for accounts that existed before verification.
  emailVerified DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Personal Pro subscription (15 BYN / month).
  subscriptionStatus   SubscriptionStatus @default(NONE)
  subscriptionEndsAt   DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  bepaidCustomerId     String?

  activeOrganizationId String?
  activeOrganization   Organization? @relation("UserActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  projects        Project[]
  folders         Folder[]
  memberships     OrganizationMember[]
  savedProjects   SavedProject[]
  authTokens      AuthToken[]
  templates       Template[]
  news            News[]
  notifications   Notification[]
  feedbacks       Feedback[]
  paymentMethods  PaymentMethod[]
  billingPayments BillingPayment[]

  @@index([activeOrganizationId])
  @@index([subscriptionStatus])
}

model Organization {
  id         String   @id @default(cuid())
  name       String
  color      String   @default("#7EB6FF")
  inviteCode String   @unique @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members        OrganizationMember[]
  folders        Folder[]
  projects       Project[]
  activeForUsers User[]               @relation("UserActiveOrganization")
}

/// Saved card for recurring Pro billing. PAN/CVV are never stored — only token + display fields.
model PaymentMethod {
  id               String   @id @default(cuid())
  brand            String
  last4            String
  expMonth         Int
  expYear          Int
  /// Provider token (bePaid card token or sandbox token).
  providerToken    String
  providerCustomer String?
  isDefault        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  payments BillingPayment[]

  @@index([userId])
}

model BillingPayment {
  id          String               @id @default(cuid())
  amount      Int
  currency    String               @default("BYN")
  status      BillingPaymentStatus @default(PENDING)
  kind        BillingPaymentKind   @default(SUBSCRIPTION)
  description String?
  providerRef String?
  failureReason String?
  paidAt      DateTime?
  createdAt   DateTime             @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
}

model OrganizationMember {
  id        String        @id @default(cuid())
  role      OrgMemberRole @default(MEMBER)
  createdAt DateTime      @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

/// Folder for grouping carousel projects (scoped to an organization).
model Folder {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projects Project[]

  @@index([userId])
  @@index([userId, updatedAt])
  @@index([organizationId])
}

/// One-time links for email confirmation and password reset.
model AuthToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, type])
}

model Project {
  id          String   @id @default(cuid())
  title       String   @default("Untitled Carousel")
  aspectRatio String   @default("4:5")
  width       Int      @default(1080)
  height      Int      @default(1350)
  canvasJSON  Json
  thumbnail  String? @db.Text
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  slides  Slide[]
  savedBy SavedProject[]

  @@index([userId])
  @@index([userId, updatedAt])
  @@index([folderId])
  @@index([organizationId])
}

/// One Fabric canvas snapshot in a carousel project.
/// Client uses ephemeral numeric ids; persistence key is `id` + `order`.
model Slide {
  id         String  @id @default(cuid())
  order      Int
  canvasJSON Json
  thumbnail  String? @db.Text

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

model Template {
  id          String   @id @default(cuid())
  title       String
  category    String
  badge       String?
  previewUrl  String?
  aspectRatio String   @default("4:5")
  canvasJSON  Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([authorId])
}

/// A post from the admin desk. Publishing one also notifies every user.
model News {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  notifications Notification[]

  @@index([createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  title     String
  body      String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  newsId String?
  news   News?   @relation(fields: [newsId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

/// User notes from the studio. Images are data URLs when attached.
model Feedback {
  id        String   @id @default(cuid())
  message   String   @db.Text
  images    String[] @default([])
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Bookmarks / "saved" projects for a user (not ownership).
model SavedProject {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}
